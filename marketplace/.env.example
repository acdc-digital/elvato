# Copy to marketplace/.env.local or marketplace/.env and fill in real values.
# Do not commit real credentials.

# Etsy app + OAuth token. API key alone is not enough for listing writes.
ETSY_API_KEY=
ETSY_CLIENT_SECRET=
# Optional override for API request header. Defaults to ETSY_API_KEY:ETSY_CLIENT_SECRET.
ETSY_API_HEADER_KEY=
ETSY_REDIRECT_URI=https://elvato.shop/callback
ETSY_OAUTH_SCOPES=profile_r shops_r listings_r listings_w
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=

# Required for creating draft listings.
ETSY_SHOP_ID=
ETSY_DEFAULT_TAXONOMY_ID=
ETSY_SHIPPING_PROFILE_ID=

# Optional listing defaults.
ETSY_RETURN_POLICY_ID=
ETSY_SHOP_SECTION_ID=
ETSY_PRODUCTION_PARTNER_IDS=
ETSY_DEFAULT_QUANTITY=999
ETSY_WHO_MADE=someone_else
ETSY_WHEN_MADE=made_to_order
ETSY_IS_SUPPLY=false
ETSY_SHOULD_AUTO_RENEW=true

# Optional variation support. Format: Medusa option title:Etsy property id,Medusa option title:Etsy property id
# Example: Color:200,Size:100
ETSY_VARIATION_PROPERTY_MAP=

# Product source reads from Medusa.
MEDUSA_BACKEND_URL=https://medusa-backend-production-d681.up.railway.app
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
