# eBay marketplace credentials and launch defaults.
# Keep real values in .env.local. Do not commit secrets.

# Register an app in the eBay Developer Program and create production keys.
EBAY_CLIENT_ID=
EBAY_DEV_ID=
EBAY_CLIENT_SECRET=
# eBay calls this the Redirect URL name / RuName, not the accepted callback URL.
EBAY_REDIRECT_URI=
EBAY_ENV=production
EBAY_OAUTH_SCOPES=

# Production account closure / marketplace account deletion notification settings.
# The endpoint must be HTTPS and deployed publicly before eBay can verify it.
EBAY_ACCOUNT_DELETION_ENDPOINT=https://elvato.shop/api/ebay/account-deletion
EBAY_ACCOUNT_DELETION_ENDPOINT_URL=https://elvato.shop/api/ebay/account-deletion
EBAY_ACCOUNT_DELETION_ENDPOINT_OVERRIDE=https://elvato.shop/api/ebay/account-deletion
EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=replace-with-32-to-80-character-token

# OAuth tokens will be needed once API publish/report scripts are added.
EBAY_ACCESS_TOKEN=
EBAY_REFRESH_TOKEN=

# Launch defaults. Fill these before live publishing.
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
EBAY_MERCHANT_LOCATION_KEY=elvato-default
EBAY_LOCATION_NAME=Elvato Fulfillment
EBAY_LOCATION_COUNTRY=US
EBAY_LOCATION_ADDRESS_LINE1=
EBAY_LOCATION_CITY=
EBAY_LOCATION_STATE_OR_PROVINCE=
EBAY_LOCATION_POSTAL_CODE=
EBAY_DEFAULT_HANDLING_DAYS=5
EBAY_DEFAULT_RETURN_DAYS=30
EBAY_DEFAULT_CONDITION=NEW

# Business policy IDs are created in eBay Seller Hub.
EBAY_PAYMENT_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=