{
  "name": "elvato-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "etsy:auth": "node ../scripts/etsy/oauth.mjs authorize",
    "etsy:token": "node ../scripts/etsy/oauth.mjs exchange",
    "etsy:refresh": "node ../scripts/etsy/oauth.mjs refresh",
    "etsy:check": "node ../scripts/etsy/publish-etsy-listing.mjs --check-shop",
    "etsy:taxonomy": "node ../scripts/etsy/taxonomy.mjs",
    "etsy:plan": "node ../scripts/etsy/publish-etsy-listing.mjs",
    "etsy:draft": "node ../scripts/etsy/publish-etsy-listing.mjs --live",
    "etsy:publish": "node ../scripts/etsy/publish-etsy-listing.mjs --live --publish",
    "etsy:select-candidates": "node ../scripts/etsy/select-alvatta-candidates.mjs",
    "etsy:select-table-floor": "node ../scripts/etsy/select-alvatta-table-floor-candidates.mjs",
    "etsy:select-brand": "node ../scripts/etsy/select-alvatta-brand-candidates.mjs",
    "etsy:optimize-drafts": "node ../scripts/etsy/optimize-etsy-drafts.mjs",
    "etsy:tag-seo": "node ../scripts/etsy/update-active-listing-tags.mjs",
    "images:ingest": "node ../scripts/etsy/image-asset-pipeline.mjs",
    "images:discover": "node ../scripts/etsy/image-asset-pipeline.mjs --discover",
    "images:enrich-prices": "node ../scripts/etsy/enrich-image-source-prices.mjs",
    "images:source-reports": "node ../scripts/etsy/generate-image-source-reports.mjs"
  }
}
