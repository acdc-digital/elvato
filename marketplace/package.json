{
  "name": "elvato-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "etsy:auth": "node ../scripts/etsy/oauth.mjs authorize",
    "etsy:token": "node ../scripts/etsy/oauth.mjs exchange",
    "etsy:refresh": "node ../scripts/etsy/oauth.mjs refresh",
    "etsy:check": "node ../scripts/etsy/publish-etsy-listing.mjs --check-shop",
    "etsy:plan": "node ../scripts/etsy/publish-etsy-listing.mjs",
    "etsy:draft": "node ../scripts/etsy/publish-etsy-listing.mjs --live",
    "etsy:publish": "node ../scripts/etsy/publish-etsy-listing.mjs --live --publish"
  }
}
