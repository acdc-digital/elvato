# Medusa backend URL (local dev: http://localhost:9000, production: your Railway URL)
MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa publishable API key (from Medusa Admin → Settings → API Key Management)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key

# Storefront base URL
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region (ISO-2 lowercase)
NEXT_PUBLIC_DEFAULT_REGION=us

# Stripe publishable key (from Stripe Dashboard → API keys)
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_stripe_publishable_key

# Convex backend URL (local dev: http://127.0.0.1:3210, production: https://your-deployment.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Next.js revalidation secret
REVALIDATE_SECRET=supersecret

# eBay marketplace account deletion notification endpoint.
# Register this URL in the eBay developer account closure policy settings.
EBAY_ACCOUNT_DELETION_ENDPOINT=https://elvato.shop/api/ebay/account-deletion
EBAY_ACCOUNT_DELETION_ENDPOINT_URL=https://elvato.shop/api/ebay/account-deletion
EBAY_ACCOUNT_DELETION_ENDPOINT_OVERRIDE=https://elvato.shop/api/ebay/account-deletion
EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=replace-with-32-to-80-character-token
