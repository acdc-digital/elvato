# Anthropic API key (required)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Neon PostgreSQL (required — from admin/.env)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Medusa Admin API (required — Railway production)
MEDUSA_BACKEND_URL=https://your-medusa-backend.up.railway.app
MEDUSA_ADMIN_EMAIL=admin@medusa-test.com
MEDUSA_ADMIN_PASSWORD=your-password

# CJ Dropshipping API (required for stock checks)
CJ_API_KEY=your-cj-api-key
