# Local development (auto-set by `npx convex dev`)
CONVEX_DEPLOYMENT=local:local-your_team-your_project
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211

# Production deploy key (for CI/CD — from Convex Dashboard → Settings → Deploy keys)
# Used by: npx convex deploy
# Format: prod:<deployment-name>|<encoded-key>
CONVEX_DEPLOY_KEY=prod:your-deployment|your_encoded_key
